use flake

if [ -n "$CC" ]; then
  INCLUDES=$(clang -E -x c - -v < /dev/null 2>&1 | \
    sed -n '/#include <...> search starts here:/,/End of search list./p' | \
    grep '^ ' | sed 's/^ //')

  {
    echo "CompileFlags:"
    echo "  Add:"

    echo "$INCLUDES" | while read -r path; do
      if [ -d "$path" ]; then
        echo "    - -isystem"
        echo "    - $path"
      fi
    done

    echo "    - -resource-dir=$(clang -print-resource-dir)"

    echo "  Compiler: $(which $CC)"
  } > .clangd

  echo ".clangd regenerated with $(echo "$INCLUDES" | wc -l) include paths"
fi
